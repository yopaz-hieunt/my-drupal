<?php

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\link\LinkItemInterface;
use Drupal\link\LinkTitleVisibility;
use Drupal\node\Entity\NodeType;

/**
 * Implements hook_install().
 */
function article_youtube_install(): void {
  $bundle = 'article';

  // Chỉ chạy khi bundle Article tồn tại.
  if (!NodeType::load($bundle)) {
    return;
  }

  $field_name = 'field_youtube_link';
  $storage = FieldStorageConfig::loadByName('node', $field_name);
  if (!$storage) {
    $storage = FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'type' => 'link',
      'cardinality' => 1,
      'settings' => [
        'link_type' => LinkItemInterface::LINK_GENERIC,
        'title' => LinkTitleVisibility::Disabled->value,
      ],
    ]);
    $storage->save();
  }

  if (!FieldConfig::loadByName('node', $bundle, $field_name)) {
    FieldConfig::create([
      'field_storage' => $storage,
      'bundle' => $bundle,
      'label' => 'YouTube',
      'description' => 'Dán URL video YouTube để hiển thị trong bài viết.',
      'settings' => [
        'title' => LinkTitleVisibility::Disabled->value,
      ],
      'required' => FALSE,
    ])->save();
  }

  $form_display = EntityFormDisplay::load("node.$bundle.default");
  if (!$form_display) {
    $form_display = EntityFormDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => $bundle,
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $form_display->setComponent($field_name, [
    'type' => 'link_default',
    'weight' => 30,
    'settings' => [
      'placeholder_url' => 'https://www.youtube.com/watch?v=abc123',
    ],
  ])->save();

  $view_display = EntityViewDisplay::load("node.$bundle.default");
  if (!$view_display) {
    $view_display = EntityViewDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => $bundle,
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $view_display->setComponent($field_name, [
    'label' => 'above',
    'type' => 'youtube_embed',
    'weight' => 30,
    'settings' => [
      'width' => 560,
      'height' => 315,
    ],
  ])->save();
}

/**
 * Implements hook_uninstall().
 */
function article_youtube_uninstall(): void {
  $field_name = 'field_youtube_link';
  if ($field = FieldConfig::loadByName('node', 'article', $field_name)) {
    $field->delete();
  }
  if ($storage = FieldStorageConfig::loadByName('node', $field_name)) {
    $storage->delete();
  }
}
