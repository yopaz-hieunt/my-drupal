{#
  Default node view template with Tailwind utility classes.
#}
<article{{ attributes.addClass('prose prose-slate max-w-none') }}>
  {% if label %}
    <header class="mb-6">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">{{ label }}</h1>
      {% if display_submitted %}
        <div class="mt-3 flex items-center gap-3 text-sm text-slate-600">
          {% if author_picture %}
            <div class="h-10 w-10 overflow-hidden rounded-full ring-2 ring-slate-200">
              {{ author_picture }}
            </div>
          {% endif %}
          <div>
            <div class="font-semibold text-slate-800">{{ author_name }}</div>
            <div class="text-slate-500">{{ date }}</div>
          </div>
        </div>
      {% endif %}
    </header>
  {% endif %}

  {% if node.isPromoted() %}
    <span class="inline-flex items-center gap-2 rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800 ring-1 ring-inset ring-amber-200 mb-4">
      {{ 'Promoted'|t }}
    </span>
  {% endif %}

  <div class="card space-y-6">
    {% if content.field_image %}
      <div class="overflow-hidden rounded-xl">
        {{ content.field_image }}
      </div>
    {% endif %}

    <div class="space-y-4">
      {{ content|without('links') }}
    </div>

    {% if content.links %}
      <div class="flex flex-wrap items-center gap-3 pt-2 border-t border-slate-200">
        {{ content.links }}
      </div>
    {% endif %}
  </div>
</article>
